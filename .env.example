# OracleProxy Configuration Example
# Copy this file to .env and adjust values as needed

# Server Configuration
WS_LISTEN_ADDR=127.0.0.1:8080
HTTP_LISTEN_ADDR=127.0.0.1:8081

# Logging
LOG_LEVEL=info

# Exchange WebSocket URLs
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
KRAKEN_WS_URL=wss://ws.kraken.com/

# Indicator Configuration (optional - defaults provided)
# EMA Periods
EMA_SHORT_PERIOD=12
EMA_LONG_PERIOD=26
EMA_VERY_LONG_PERIOD=50

# RSI Configuration
RSI_PERIOD=14

# MACD Configuration
MACD_FAST_PERIOD=12
MACD_SLOW_PERIOD=26
MACD_SIGNAL_PERIOD=9

# Volatility Configuration
VOLATILITY_PERIOD=20

# Storage Configuration
PRICE_HISTORY_CAPACITY=1000
AGGREGATION_INTERVAL_MS=500

# Performance Tuning
MAX_WEBSOCKET_CLIENTS=1000
BROADCAST_CHANNEL_CAPACITY=100

# Optional: Chainlink Configuration
# CHAINLINK_RPC_URL=https://polygon-rpc.com
# CHAINLINK_FEED_ADDRESS=0x...

# Optional: Polymarket Configuration
# POLYMARKET_RTDS_URL=wss://...
# POLYMARKET_API_KEY=...

# Optional: Database (for historical data)
# DATABASE_URL=sqlite://oracle.db
# or
# DATABASE_URL=postgres://user:password@localhost/oracle
