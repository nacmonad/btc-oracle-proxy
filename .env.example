# OracleProxy Configuration Example
# Copy this file to .env and adjust values as needed

# Server Configuration
WS_LISTEN_ADDR=127.0.0.1:8080
HTTP_LISTEN_ADDR=127.0.0.1:8081

# Logging
LOG_LEVEL=info

# Exchange WebSocket URLs
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
KRAKEN_WS_URL=wss://ws.kraken.com/

# Indicator Configuration (optional - defaults provided)
# EMA Periods
EMA_SHORT_PERIOD=12
EMA_LONG_PERIOD=26
EMA_VERY_LONG_PERIOD=50

# RSI Configuration
RSI_PERIOD=14

# MACD Configuration
MACD_FAST_PERIOD=12
MACD_SLOW_PERIOD=26
MACD_SIGNAL_PERIOD=9

# Volatility Configuration
VOLATILITY_PERIOD=20

# Storage Configuration
PRICE_HISTORY_CAPACITY=1000
AGGREGATION_INTERVAL_MS=500

# Performance Tuning
MAX_WEBSOCKET_CLIENTS=1000
BROADCAST_CHANNEL_CAPACITY=100

# Optional: Polymarket Configuration
#POLYGON_RPC_URL=...
#POLYGON_API_KEY=...

# Optional: Shared DuckDB path (for writing directly into polymarket-researcher schema)
RESEARCHER_DB_PATH=../data/researcher.db

# CLOB WS-first ingestion (no creds required for public market data)
CLOB_ENABLED=true
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
CLOB_POLL_INTERVAL_MS=500
CLOB_INITIAL_BACKOFF_MS=500
CLOB_MAX_BACKOFF_MS=60000
CLOB_WRITER_FLUSH_MS=500
CLOB_MARKET_REFRESH_MS=60000
CLOB_GAMMA_API_URL=https://gamma-api.polymarket.com
# Emit at most one DB snapshot per token per interval (latest-wins sampling)
CLOB_SAMPLE_INTERVAL_MS=100
# Even if unchanged, force periodic refresh row for each token
CLOB_SAMPLE_FORCE_EMIT_MS=2000
CLOB_ASSETS=BTC
CLOB_TIMEFRAMES=5m,15m

# Optional: Database URL (legacy/future SQL backends)
# DATABASE_URL=sqlite://oracle.db
# or
# DATABASE_URL=postgres://user:password@localhost/oracle
